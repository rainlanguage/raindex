pragma solidity =0.8.25;

import {RaindexV7St0xFixedSpreadFork} from "./abstract/RaindexV7St0xFixedSpreadFork.sol";

/// @title RaindexV7St0xFixedSpreadBaseForkTest
/// @notice Base fork coverage for the live SPYM sell order of
/// st0x-fixed-spread-v7.
///
/// Run:
/// `BASE_MAINNET_RPC_URL=<rpc> forge test --match-contract RaindexV7St0xFixedSpreadBaseForkTest -vvv`
contract RaindexV7St0xFixedSpreadBaseForkTest is RaindexV7St0xFixedSpreadFork {
    address internal constant RAINDEX = 0xe522cB4a5fCb2eb31a52Ff41a4653d85A4fd7C9D;
    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
    address internal constant WT_VAULT = 0x31C2C14134e6E3B7ef9478297F199331133Fc2d8;

    bytes32 internal constant EXPECTED_ORDER_HASH =
        0x6aaf2b86bcc03545b337fd094e56eb0e5240da3cb20b7053abb7428433dd0d67;

    bytes internal constant ORDER_BYTES =
        hex"";

    function _rpcEnvKey() internal pure override returns (string memory) {
        return "BASE_MAINNET_RPC_URL";
    }

    function _rpcFallback() internal pure override returns (string memory) {
        return "https://mainnet.base.org";
    }

    function _raindex() internal pure override returns (address) {
        return RAINDEX;
    }

    function _usdc() internal pure override returns (address) {
        return USDC;
    }

    function _wtVault() internal pure override returns (address) {
        return WT_VAULT;
    }

    function _expectedOrderHash() internal pure override returns (bytes32) {
        return EXPECTED_ORDER_HASH;
    }

    function _orderBytes() internal pure override returns (bytes memory) {
        return ORDER_BYTES;
    }

    function _expectedChainId() internal pure override returns (uint256) {
        return 8453;
    }

    function _usdcDecimals() internal pure override returns (uint8) {
        return 6;
    }
}
