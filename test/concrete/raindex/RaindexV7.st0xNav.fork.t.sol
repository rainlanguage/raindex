pragma solidity =0.8.25;

import {Test, console2} from "forge-std-1.16.1/src/Test.sol";
import {IERC20} from "@openzeppelin-contracts-5.6.1/token/ERC20/IERC20.sol";
import {IERC4626} from "@openzeppelin-contracts-5.6.1/interfaces/IERC4626.sol";
import {MessageHashUtils} from "@openzeppelin-contracts-5.6.1/utils/cryptography/MessageHashUtils.sol";
import {
    IRaindexV6,
    QuoteV2,
    OrderV4,
    OrderConfigV4,
    EvaluableV4,
    IOV2,
    IInterpreterV4,
    IInterpreterStoreV3,
    SignedContextV1,
    TakeOrderConfigV4,
    TakeOrdersConfigV5,
    TaskV2,
    Float
} from "raindex-interface-0.1.1/src/interface/IRaindexV6.sol";
import {LibOrder} from "../../../src/lib/LibOrder.sol";
import {LibDecimalFloat} from "rain-math-float-0.1.1/src/lib/LibDecimalFloat.sol";
import {LibHashNoAlloc} from "rain-lib-hash-0.1.0/src/LibHashNoAlloc.sol";

/// @dev Public parse entrypoint of the Base DISpair. `parse2` lives on the
/// expression deployer, which implements `IParserV2` (this is what the
/// off-chain tooling calls; see the note above `_addOrder`).
interface IParserV2 {
    function parse2(bytes calldata data) external view returns (bytes calldata bytecode);
}

/// @title RaindexV7St0xNavForkTest
/// @notice Base fork coverage for st0x-fixed-spread-v7's DERIVED vault price
/// (RAI-2199 / RAI-2203, the "derive, don't gate" pivot). Unlike v6 — which
/// signed the NAV ratio at slot 9 and reverted any fill whose live NAV had
/// moved — v7 signs only the UNDERLYING price at slot 1 and derives the
/// vault-share order ratio on-chain:
///
///   sell (vault = output token, ratio quote/share):
///       io = underlying * erc4626-convert-to-assets(vault, 1 share)
///   buy  (vault = input token,  ratio shares/quote):
///       io = underlying * erc4626-convert-to-shares(vault, 1 asset)
///
/// Three properties are asserted:
///   (a) SELL: quote+take executes and the returned io-ratio equals the
///       INDEPENDENTLY computed `underlying * live convertToAssets(1 share)`;
///   (b) BUY:  same, against `underlying * live convertToShares(1 asset)` —
///       this path also proves `erc4626-convert-to-shares` resolves on the
///       deployed subparser (it is exercised at parse AND at eval);
///   (c) a dividend-style NAV step BETWEEN quote and take does NOT revert —
///       the fill re-prices at the new live conversion. v6 reverted here with
///       "Vault NAV ratio mismatch"; this is the whole point of the pivot
///       (audit H03 DoS surface).
///
/// Run:
/// `BASE_MAINNET_RPC_URL=<rpc> forge test --match-contract RaindexV7St0xNavForkTest -vvv`
///
/// FIXTURE PROVENANCE — there is no live v7 order (the `/context/v7` oracle is
/// not in prod), so unlike the v6 harness this test does NOT hardcode a
/// deployed order's calldata. Instead it is fully self-contained:
///
///  * ORDER: the two composed rainlang strings below (`RAINLANG_SELL` /
///    `RAINLANG_BUY`) are the flat compositions of
///    `st0x.registry:src/st0x-fixed-spread-v7.rain` (branch
///    `2026-09-02-st0x-fixed-spread-v7`, PR #59) for the `base-sell` /
///    `base-buy` scenarios, with `oracle-signer` bound to this test's key.
///    They are produced OFFLINE by `compose_to_rainlang` (dotrain v6.0.1-alpha.24;
///    see the regen note at the bottom of this file) and parsed here, on the
///    fork, by the Base DISpair `parse2` — so word resolution (including
///    `erc4626-convert-to-shares`) is proven against the DEPLOYED subparser.
///    The resulting bytecode + the DISpair interpreter/store form the OrderV4,
///    which is added live via `addOrder4`.
///
///  * SIGNED CONTEXT: `/context/v7` cannot be captured from prod, so the order
///    is composed with a TEST `oracle-signer` (`ORACLE_SIGNER`, the address of
///    `TEST_SIGNER_PK`) and the 9-slot v7 frame is signed in-test with that key
///    using the exact scheme `LibContext.build` verifies:
///    `toEthSignedMessageHash(LibHashNoAlloc.hashWords(context))`. The signed
///    slot-1 underlying price is the INDEPENDENT input; expected io = that
///    price * the vault's live convert word. Time/session slots (2..5, 8) and
///    the fork tip / warp target are the v6 fixture's, so every session and
///    expiry guard passes exactly as it did for v6.
contract RaindexV7St0xNavForkTest is Test {
    using LibOrder for OrderV4;
    using LibDecimalFloat for Float;

    address internal constant RAINDEX = 0xe522cB4a5fCb2eb31a52Ff41a4653d85A4fd7C9D;
    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
    address internal constant WT_VAULT = 0x997baE3EC193a249596d3708C3fAB7C501Bb8a53;

    // Base DISpair (from the `rainlangs.base` deployer facade
    // 0x22508460712C350e914b49155982d3A92D923b10). `parse2` is served by the
    // expression deployer; the interpreter/store are baked into the OrderV4.
    address internal constant DEPLOYER = 0x36ee19F427a4a2448B6b8458e07a27BaE1654048;
    address internal constant INTERPRETER = 0x3bF9bd9DA4784f75c92317e61c68493Ecc9aaBDC;
    address internal constant STORE = 0x1Aa775533E28B1D843e1A589034984E3a62005DC;

    // Test oracle signer. The composed orders bind `oracle-signer` to this
    // address, and this key signs the v7 frames below.
    uint256 internal constant TEST_SIGNER_PK = 0x0123456789012345678901234567890123456789012345678901234567890123;
    address internal constant ORACLE_SIGNER = 0x14791697260E4c9A71f18484C9f997B308e59325;

    address internal constant ORDER_OWNER = address(0xA11CE);
    bytes32 internal constant VAULT_ID = bytes32(uint256(0x570b));
    bytes32 internal constant NONCE = bytes32(uint256(0x7));

    // v6 fixture tip; the vault is at par here so the NAV-step case is the
    // meaningful magnitude check.
    uint256 internal constant FORK_BLOCK = 0x300ffbd;
    // Warp inside the signed frame's publish/session/expiry window (v6 fixture).
    uint256 internal constant ORACLE_PUBLISH_TIME = 0x6a8c5c5b;

    uint256 internal constant DEPOSIT_SHARES = 1e15;
    uint256 internal constant ONE = 1e18;

    // Composed rainlang for the base-sell scenario (wt vault = OUTPUT token).
    bytes internal constant RAINLANG_SELL =
        hex"";
    // Composed rainlang for the base-buy scenario (wt vault = INPUT token).
    bytes internal constant RAINLANG_BUY =
        hex"";

    // Independent signed underlying price (Rain Float): 100 * 10^0 = 100.
    // Expected io is this times the vault's live conversion word.
    function _underlyingPrice() internal pure returns (Float) {
        return LibDecimalFloat.packLossless(100, 0);
    }

    function setUp() public {
        string memory rpc = vm.envOr("BASE_MAINNET_RPC_URL", string("https://mainnet.base.org"));
        vm.createSelectFork(rpc, FORK_BLOCK);
        vm.warp(ORACLE_PUBLISH_TIME);
        // The synthetic oracle signer must verify via ECDSA, not EIP-1271.
        // On Base many addresses carry an EIP-7702 delegation (23 bytes of
        // code), which would route `SignatureChecker` down the 1271 path;
        // clear any code at the signer so recovery is plain ECDSA.
        vm.etch(ORACLE_SIGNER, "");
    }

    // -------- (a) derived price, SELL direction (vault = output) --------

    function testSellQuoteAndTakeDerivesFromLiveConvertToAssets() external {
        OrderV4 memory order = _addOrder(RAINLANG_SELL, USDC, WT_VAULT);
        SignedContextV1[] memory signedContext = _signedContext(USDC, WT_VAULT);

        _depositOutputShares(order, DEPOSIT_SHARES);

        (bool success,, Float ioRatio) = _quote(order, signedContext);
        assertTrue(success, "sell quote should succeed");

        // Independent expected: underlying (slot 1) * assets-per-share.
        Float expected = _underlyingPrice().mul(_erc4626ConvertToAssetsFloat(WT_VAULT, ONE));
        _logFloat("sell expected io", expected);
        _logFloat("sell actual   io", ioRatio);
        assertTrue(ioRatio.eq(expected), "sell io-ratio must equal underlying * convertToAssets(1 share)");

        _fundUsdcAndApprove(1_000_000e6);
        (Float totalIn, Float totalOut) = IRaindexV6(RAINDEX).takeOrders4(_takeConfig(order, signedContext));
        assertFalse(totalIn.isZero(), "taker should receive shares");
        assertFalse(totalOut.isZero(), "taker should pay USDC");
    }

    // -------- (b) derived price, BUY direction (vault = input) --------

    function testBuyQuoteAndTakeDerivesFromLiveConvertToShares() external {
        OrderV4 memory order = _addOrder(RAINLANG_BUY, WT_VAULT, USDC);
        SignedContextV1[] memory signedContext = _signedContext(WT_VAULT, USDC);

        _depositOutputUsdc(order, 1_000_000e6);

        (bool success,, Float ioRatio) = _quote(order, signedContext);
        assertTrue(success, "buy quote should succeed");

        // Independent expected: underlying (slot 1) * shares-per-asset. Reaching
        // a non-zero ioRatio here is the on-chain proof that
        // `erc4626-convert-to-shares` exists on the deployed subparser.
        Float expected = _underlyingPrice().mul(_erc4626ConvertToSharesFloat(WT_VAULT, ONE));
        _logFloat("buy expected io", expected);
        _logFloat("buy actual   io", ioRatio);
        assertTrue(ioRatio.eq(expected), "buy io-ratio must equal underlying * convertToShares(1 asset)");

        _fundSharesAndApprove(DEPOSIT_SHARES);
        (Float totalIn, Float totalOut) = IRaindexV6(RAINDEX).takeOrders4(_takeConfig(order, signedContext));
        assertFalse(totalIn.isZero(), "taker should receive USDC");
        assertFalse(totalOut.isZero(), "taker should pay shares");
    }

    // -------- (c) NAV step must RE-PRICE, not revert --------

    function testTakeStillSucceedsWhenNavStepsAfterQuote() external {
        OrderV4 memory order = _addOrder(RAINLANG_SELL, USDC, WT_VAULT);
        SignedContextV1[] memory signedContext = _signedContext(USDC, WT_VAULT);

        _depositOutputShares(order, DEPOSIT_SHARES);
        (bool success,,) = _quote(order, signedContext);
        assertTrue(success, "quote should succeed before NAV step");

        uint256 navBefore = IERC4626(WT_VAULT).convertToAssets(ONE);
        _donateUnderlyingToVault(1_000e18);
        uint256 navAfter = IERC4626(WT_VAULT).convertToAssets(ONE);
        assertTrue(navAfter != navBefore, "donate must change convertToAssets(1e18)");
        console2.log("navBefore", navBefore);
        console2.log("navAfter", navAfter);

        // v6 reverted here ("Vault NAV ratio mismatch"). v7 re-prices at the
        // NEW live conversion and the take still executes.
        (, Float ioRatioAfter) = _requoteRatio(order, signedContext);
        Float expectedAfter = _underlyingPrice().mul(_erc4626ConvertToAssetsFloat(WT_VAULT, ONE));
        _logFloat("post-step expected io", expectedAfter);
        _logFloat("post-step actual   io", ioRatioAfter);
        assertTrue(ioRatioAfter.eq(expectedAfter), "post-step io-ratio must track the new live NAV");

        _fundUsdcAndApprove(1_000_000e6);
        (Float totalIn, Float totalOut) = IRaindexV6(RAINDEX).takeOrders4(_takeConfig(order, signedContext));
        assertFalse(totalIn.isZero(), "fill still executes after NAV step");
        assertFalse(totalOut.isZero(), "fill still executes after NAV step");
    }

    // ------------------------- helpers -------------------------

    /// Parse the composed rainlang on the fork (proving subparser word
    /// resolution), assemble the OrderV4, and add it live via `addOrder4`.
    function _addOrder(bytes memory rainlang, address inputToken, address outputToken)
        internal
        returns (OrderV4 memory order)
    {
        bytes memory bytecode = IParserV2(DEPLOYER).parse2(rainlang);

        IOV2[] memory inputs = new IOV2[](1);
        inputs[0] = IOV2({token: inputToken, vaultId: VAULT_ID});
        IOV2[] memory outputs = new IOV2[](1);
        outputs[0] = IOV2({token: outputToken, vaultId: VAULT_ID});

        EvaluableV4 memory evaluable = EvaluableV4({
            interpreter: IInterpreterV4(INTERPRETER), store: IInterpreterStoreV3(STORE), bytecode: bytecode
        });

        OrderConfigV4 memory config = OrderConfigV4({
            evaluable: evaluable, validInputs: inputs, validOutputs: outputs, nonce: NONCE, secret: bytes32(0), meta: ""
        });

        vm.prank(ORDER_OWNER);
        IRaindexV6(RAINDEX).addOrder4(config, new TaskV2[](0));

        order = OrderV4({
            owner: ORDER_OWNER, evaluable: evaluable, validInputs: inputs, validOutputs: outputs, nonce: NONCE
        });
    }

    /// 9-slot v7 frame (NO slot 9), signed by `TEST_SIGNER_PK` with the exact
    /// scheme `LibContext.build` authenticates.
    function _signedContext(address inputToken, address outputToken)
        internal
        pure
        returns (SignedContextV1[] memory signedContext)
    {
        bytes32[] memory context = new bytes32[](9);
        context[0] = bytes32(uint256(7)); // schema version
        context[1] = Float.unwrap(_underlyingPrice()); // underlying price (Rain Float)
        context[2] = bytes32(uint256(0x6a8c5c5b)); // publish time (v6 fixture)
        context[3] = bytes32(uint256(0x727468e3)); // session tag "rth" (IntOrAString V3)
        context[4] = bytes32(uint256(0x6a8c4758)); // session start (v6 fixture)
        context[5] = bytes32(uint256(0x6a8ca2c0)); // session end (v6 fixture)
        context[6] = bytes32(uint256(uint160(inputToken))); // input token
        context[7] = bytes32(uint256(uint160(outputToken))); // output token
        context[8] = bytes32(uint256(0x6a8c5c6f)); // frame expiry (v6 fixture)

        bytes32 digest = MessageHashUtils.toEthSignedMessageHash(LibHashNoAlloc.hashWords(context));
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(TEST_SIGNER_PK, digest);

        signedContext = new SignedContextV1[](1);
        signedContext[0] =
            SignedContextV1({signer: ORACLE_SIGNER, context: context, signature: abi.encodePacked(r, s, v)});
    }

    function _quote(OrderV4 memory order, SignedContextV1[] memory signedContext)
        internal
        view
        returns (bool success, Float maxOutput, Float ioRatio)
    {
        return IRaindexV6(RAINDEX)
            .quote2(QuoteV2({order: order, inputIOIndex: 0, outputIOIndex: 0, signedContext: signedContext}));
    }

    function _requoteRatio(OrderV4 memory order, SignedContextV1[] memory signedContext)
        internal
        view
        returns (bool success, Float ioRatio)
    {
        (success,, ioRatio) = _quote(order, signedContext);
    }

    function _erc4626ConvertToAssetsFloat(address vault, uint256 shares) internal view returns (Float) {
        return LibDecimalFloat.fromFixedDecimalLosslessPacked(IERC4626(vault).convertToAssets(shares), 18);
    }

    function _erc4626ConvertToSharesFloat(address vault, uint256 assets) internal view returns (Float) {
        return LibDecimalFloat.fromFixedDecimalLosslessPacked(IERC4626(vault).convertToShares(assets), 18);
    }

    function _logFloat(string memory label, Float f) internal pure {
        (uint256 fixed18,) = f.toFixedDecimalLossy(18);
        console2.log(label, fixed18);
    }

    function _takeConfig(OrderV4 memory order, SignedContextV1[] memory signedContext)
        internal
        pure
        returns (TakeOrdersConfigV5 memory)
    {
        TakeOrderConfigV4[] memory orders = new TakeOrderConfigV4[](1);
        orders[0] = TakeOrderConfigV4({order: order, inputIOIndex: 0, outputIOIndex: 0, signedContext: signedContext});
        return TakeOrdersConfigV5({
            minimumIO: LibDecimalFloat.packLossless(0, 0),
            maximumIO: LibDecimalFloat.fromFixedDecimalLosslessPacked(1e12, 18),
            maximumIORatio: LibDecimalFloat.packLossless(type(int224).max, 0),
            IOIsInput: true,
            orders: orders,
            data: ""
        });
    }

    function _depositOutputShares(OrderV4 memory order, uint256 shareAmount) internal {
        address owner = order.owner;
        bytes32 vaultId = order.validOutputs[0].vaultId;
        deal(WT_VAULT, owner, shareAmount);
        vm.startPrank(owner);
        IERC20(WT_VAULT).approve(RAINDEX, shareAmount);
        IRaindexV6(RAINDEX)
            .deposit4(
                WT_VAULT, vaultId, LibDecimalFloat.fromFixedDecimalLosslessPacked(shareAmount, 18), new TaskV2[](0)
            );
        vm.stopPrank();
    }

    function _depositOutputUsdc(OrderV4 memory order, uint256 amount) internal {
        address owner = order.owner;
        bytes32 vaultId = order.validOutputs[0].vaultId;
        deal(USDC, owner, amount);
        vm.startPrank(owner);
        IERC20(USDC).approve(RAINDEX, amount);
        IRaindexV6(RAINDEX)
            .deposit4(USDC, vaultId, LibDecimalFloat.fromFixedDecimalLosslessPacked(amount, 6), new TaskV2[](0));
        vm.stopPrank();
    }

    function _fundUsdcAndApprove(uint256 amount) internal {
        deal(USDC, address(this), amount);
        IERC20(USDC).approve(RAINDEX, type(uint256).max);
    }

    function _fundSharesAndApprove(uint256 amount) internal {
        deal(WT_VAULT, address(this), amount);
        IERC20(WT_VAULT).approve(RAINDEX, type(uint256).max);
    }

    /// Dividend-style NAV step: push underlying into the vault without minting shares.
    function _donateUnderlyingToVault(uint256 amount) internal {
        address asset = IERC4626(WT_VAULT).asset();
        deal(asset, address(this), amount);
        IERC20(asset).transfer(WT_VAULT, amount);
    }
}

// REGEN — how RAINLANG_SELL / RAINLANG_BUY were produced (deterministic):
//
//   1. Fetch the strategy:
//        git -C st0x.registry show 2026-09-02-st0x-fixed-spread-v7:src/st0x-fixed-spread-v7.rain > v7.rain
//   2. Compose base-sell / base-buy to flat rainlang with the test signer,
//      using `raindex_common::rainlang::compose_to_rainlang` (dotrain
//      v6.0.1-alpha.24), entrypoints ["calculate-io","handle-io"] and bindings:
//        raindex-subparser = 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
//        erc4626-subparser = 0xd69dC3d58a7C875117f9c7cecF4F1A7f3CA47254
//        oracle-signer     = 0x14791697260E4c9A71f18484C9f997B308e59325  (vm.addr(TEST_SIGNER_PK))
//        oracle-schema-version = 7
//        wt-vault          = 0x997baE3EC193a249596d3708C3fAB7C501Bb8a53
//        derive-fn         = 'derive-sell   (sell)   |   'derive-buy   (buy)
//        min-price         = 0.000001
//        max-price         = 1000000
//   3. Hex-encode each composed rainlang (UTF-8) into the `bytes constant`s above.
//   The strings are parsed here on the fork by the Base DISpair `parse2`, so any
//   drift in the strategy or the deployed subparser surfaces as a parse/exec
//   failure rather than silently passing.
